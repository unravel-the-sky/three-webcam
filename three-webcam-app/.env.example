# Copy to .env and fill in. Next.js reads .env / .env.local for the app; prisma.config.ts loads the same files for the Prisma CLI.

# --- Postgres (any provider: Neon, Supabase, Railway, Vercel Postgres, local docker) ---
DATABASE_URL="postgresql://user:password@host:5432/three_webcam?sslmode=require"
# Optional: a non-pooled connection for `prisma migrate` (Neon's Vercel integration sets this automatically)
# DATABASE_URL_UNPOOLED=""

# --- Ably realtime (phones <-> big screen). Server-side only: browsers get short-lived tokens from /api/ably/token ---
ABLY_API_KEY="appId.keyId:keySecret"

# --- AWS S3: selfies are uploaded to `webcam/<username>-<uuid>` and served publicly from the bucket ---
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""

# --- next-auth: Google sign-in guards the /admin big-screen page ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""            # generate with: openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google account emails that are allowed into /admin
ADMIN_EMAILS="you@example.com"
